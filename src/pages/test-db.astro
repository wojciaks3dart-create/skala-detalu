---
const db = Astro.locals.runtime.env.DB;

const result = await db
    .prepare("SELECT * FROM models")
    .all();

const models = result.results;
---

<html>

<head>
    <title>Test D1</title>
</head>

<body>

<h1>Modele z D1</h1>

<ul>

{
    models.map(model => (

        <li>

            {model.title}

        </li>

    ))
}

</ul>

</body>

</html>
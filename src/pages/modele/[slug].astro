---
import { env } from "cloudflare:workers";
import MainLayout from "../../layouts/MainLayout.astro";

const slug = Astro.params.slug;

const result = await env.DB
  .prepare("SELECT * FROM models WHERE slug = ?")
  .bind(slug)
  .all();

const model = result.results[0];

if (!model) {
  return new Response("Model nie istnieje", {
    status: 404
  });
}
---

<MainLayout title={model.title}>

<section class="model-page">

    <div class="hero">
        <img
            src={model.image}
            alt={model.title}
        />
    </div>

    <h1>{model.title}</h1>

    <p class="category">
        {model.category}
    </p>

    <p class="description">
        {model.short_description}
    </p>

    <p class="status">
        Status: {model.status}
    </p>

    <section class="full-description">

        <h2>Opis modelu</h2>

        <p>
            {model.description}
        </p>

    </section>

</section>

<style>

.model-page{
    max-width:1100px;
    margin:auto;
}

.hero{
    margin:40px 0;
}

.hero img{
    width:100%;
    max-height:700px;
    object-fit:contain;
}

h1{
    margin-bottom:15px;
}

.category{
    color:#7a3e2e;
    font-weight:bold;
    margin-bottom:10px;
}

.description{
    font-size:1.1rem;
    margin-bottom:20px;
}

.status{
    margin-bottom:30px;
}

.full-description{
    margin-top:40px;
}

.full-description h2{
    margin-bottom:15px;
}

.full-description p{
    line-height:1.8;
}

</style>

</MainLayout>
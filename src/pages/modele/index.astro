---
import MainLayout from "../../layouts/MainLayout.astro";
import ModelCard from "../../components/ModelCard.astro";
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="Modele | Skala Detalu">

<section class="page-header">

    <h1>Modele</h1>

    <p>
        Katalog modeli architektury dostępnych w ofercie.
    </p>

</section>

<nav class="category-nav">

    <a href="#stacje">Stacje</a>
    <a href="#kamienice">Kamienice</a>
    <a href="#nastawnie">Nastawnie</a>
    <a href="#magazyny">Magazyny</a>

</nav>

<section id="stacje" class="category">

    <h2>Stacje kolejowe</h2>

    <div class="grid">

        <ModelCard
    title="Kasina Wielka"
    category="Stacja kolejowa"
    scales="H0 • TT • N"
    image="/images/kasina.jpg"
    link="/modele/kasina-wielka"
/>

            <img src="/images/kasina.jpg" alt="Kasina Wielka">

            <div class="content">
                <h3>Kasina Wielka</h3>
                <p>H0 • TT • N</p>
            </div>

        </a>

    </div>

</section>

<section id="kamienice" class="category">

    <h2>Kamienice</h2>

    <div class="empty">
        Brak modeli w tej kategorii.
    </div>

</section>

<section id="nastawnie" class="category">

    <h2>Nastawnie</h2>

    <div class="empty">
        Brak modeli w tej kategorii.
    </div>

</section>

<section id="magazyny" class="category">

    <h2>Magazyny</h2>

    <div class="empty">
        Brak modeli w tej kategorii.
    </div>

</section>

<style>

.page-header{
    margin:50px 0 30px;
}

.page-header h1{
    font-size:3rem;
    margin-bottom:10px;
}

.category-nav{
    position:sticky;
    top:80px;
    display:flex;
    gap:15px;
    flex-wrap:wrap;
    background:white;
    padding:15px;
    margin-bottom:50px;
    border:1px solid #d9d9d9;
    border-radius:10px;
    z-index:10;
}

.category-nav a{
    text-decoration:none;
    color:#2c2c2c;
    font-weight:bold;
}

.category-nav a:hover{
    color:#7a3e2e;
}

.category{
    margin-bottom:80px;
}

.category h2{
    margin-bottom:25px;
    border-bottom:2px solid #7a3e2e;
    padding-bottom:10px;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(350px,1fr));
    gap:30px;
}

.card{
    display:block;
    text-decoration:none;
    color:inherit;
    background:white;
    border:1px solid #d9d9d9;
    border-radius:12px;
    overflow:hidden;
    transition:.2s;
}

.card:hover{
    transform:translateY(-4px);
}

.card img{
    width:100%;
    height:300px;
    object-fit:contain;
    background:#f5f5f5;
}

.content{
    padding:20px;
}

.content h3{
    margin-bottom:10px;
}

.empty{
    color:#777;
    padding:20px 0;
}

</style>

</MainLayout>
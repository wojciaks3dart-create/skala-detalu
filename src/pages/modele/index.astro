---
import { env } from "cloudflare:workers";
import MainLayout from "../../layouts/MainLayout.astro";
import ModelCard from "../../components/ModelCard.astro";

let models = [];

if (env.DB) {
  const result = await env.DB
    .prepare("SELECT * FROM models ORDER BY title")
    .all();

  models = result.results;
}
---

<MainLayout title="Modele | Skala Detalu">

<section class="page-header">
  <h1>Modele</h1>

  <p>
    Katalog modeli architektury dostępnych w ofercie.
  </p>
</section>

<div class="grid">
  {
    models.map((model) => (
      <ModelCard
        title={model.title}
        category={model.category}
        scales=""
        image={model.image}
        link={`/modele/${model.slug}`}
      />
    ))
  }
</div>

<style>
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(350px,1fr));
  gap:30px;
}
</style>

</MainLayout>
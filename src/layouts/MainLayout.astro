---
const { title = "Skala Detalu" } = Astro.props;
---

<html lang="pl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <style>
        :root{
            --bg:#f5f5f5;
            --text:#2c2c2c;
            --accent:#7a3e2e;
            --border:#d9d9d9;
        }

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

       body{
    background:white;
    color:var(--text);
    font-family:Arial,sans-serif;
}

        header{
            background:white;
            border-bottom:1px solid var(--border);
        }

        .container{
            max-width:1200px;
            margin:auto;
            padding:20px;
        }

       .topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    min-height:140px;
}

        .logo{
            font-size:28px;
            font-weight:bold;
            color:var(--accent);
            text-decoration:none;
        }

        nav{
            display:flex;
            gap:25px;
        }

        nav a{
            text-decoration:none;
            color:var(--text);
            font-weight:bold;
        }

        nav a:hover{
            color:var(--accent);
        }

        main{
            min-height:80vh;
        }

        footer{
            margin-top:60px;
            border-top:1px solid var(--border);
            text-align:center;
            padding:30px;
        }

.logo{
    display:flex;
    align-items:center;
}

.logo img{
    height:100px;
    width:auto;
    display:block;

    transform:scale(1.5);
    transform-origin:left center;
}


    </style>
</head>

<body>

<header>
    <div class="container topbar">
<a href="/" class="logo">
    <img
        src="/images/logo.png"
        alt="Skala Detalu"
    />
</a>

</a>

        <nav>
            <a href="/">Start</a>
            <a href="/modele">Modele</a>
            <a href="/oferta">Oferta</a>
            <a href="/kontakt">Kontakt</a>
        </nav>

    </div>
</header>

<main class="container">
    <slot />
</main>

<footer>
    © 2026 Skala Detalu
</footer>

</body>
</html>
---
const {
    title,
    category,
    scales,
    image,
    link
} = Astro.props;
---

<a href={link} class="card">

    <img
        src={image}
        alt={title}
    >

    <div class="content">

        <h3>{title}</h3>

        <div class="category">
            {category}
        </div>

        <div class="scales">
            {scales}
        </div>

    </div>

</a>

<style>

.card{
    display:block;

    text-decoration:none;
    color:inherit;

    background:white;

    border:1px solid #d9d9d9;
    border-radius:12px;

    overflow:hidden;

    transition:.2s;
}

.card:hover{
    transform:translateY(-4px);
}

.card img{
    width:100%;
    height:300px;

    object-fit:contain;

    background:#f5f5f5;
}

.content{
    padding:20px;
}

.content h3{
    margin-bottom:10px;
}

.category{
    color:#7a3e2e;
    font-weight:bold;
    margin-bottom:10px;
}

.scales{
    color:#666;
}

</style>